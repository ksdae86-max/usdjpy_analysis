name: USD/JPY Market Analysis

on:
  schedule:
    # 日本時間 火曜日〜土曜日の午前9:15に実行 (UTC 0:15)
    # これにより、月曜〜金曜の確定日足が重複なく記録されます
    - cron: '15 0 * * 2-6'
  workflow_dispatch: # 手動実行ボタン

jobs:
  analyze:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          # yfinanceの最新仕様に対応
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests pandas numpy yfinance

      - name: Run analysis
        env:
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
          GSHEET_URL: ${{ secrets.GSHEET_URL }}
        run: python wick_detector.py
